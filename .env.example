# Root Docker Compose Environment Template (Copy to .env on VPS before running docker compose)
DOMAIN_NAME=face.yourdomain.com
ALLOWED_ORIGINS=https://face.yourdomain.com

# Microsoft SQL Server 2022
SQLSERVER_DB=SpaceXBiometricDB
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeMe_StrongSqlPassword2026!
# Use Standard (licensed) or Express (free) on production Linux VPS
MSSQL_PID=Express

# High-Concurrency Pool & Auth Rate Limiting
DB_POOL_SIZE=16
DB_CONNECT_TIMEOUT=10
AUTH_RATE_LIMIT_PER_MIN=180

